POSTGRES_DB=dms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONN_HEALTH_CHECKS=True

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents
QDRANT_HEALTH_CHECK=False

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

DJANGO_SECRET_KEY=change-me-before-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_TIME_ZONE=Asia/Qyzylorda
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_DIR=.
DJANGO_LOG_FILE=errors.log
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_USE_X_FORWARDED_HOST=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SESSION_COOKIE_AGE=1800
DJANGO_SESSION_EXPIRE_AT_BROWSER_CLOSE=True
DJANGO_SESSION_SAVE_EVERY_REQUEST=True
DJANGO_LOGIN_RATE_LIMIT_ATTEMPTS=5
DJANGO_LOGIN_RATE_LIMIT_WINDOW=900
DJANGO_STATIC_URL=/static/
DJANGO_STATIC_ROOT=staticfiles
DJANGO_MEDIA_URL=/media/
DJANGO_MEDIA_ROOT=media
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=52428800
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=52428800

HEALTH_CHECK_DATABASE=True
HEALTH_CHECK_QDRANT=False

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
PORT=8000
